# ── Relay (copy to dumpling/relay/.env) ──────────────────────────────────────

# Leave as SQLite for local dev; set a Postgres URL for Fly.io
DATABASE_URL=sqlite:///./dumpling.db

# Long random string — generate with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_SECRET=change-me

# Dev-only shortcut token — use this in local testing / curl
DEV_TOKEN=dumpling-dev-token

# Where to store uploaded images
UPLOAD_DIR=./uploads

# Max image upload size in MB
MAX_UPLOAD_MB=20

# Telegram bot — message @YourBot to send items to Dumpling (no curl)
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_SECRET_TOKEN=       # optional, for webhook verification


# ── Mac Agent (copy to dumpling/agent/.env) ───────────────────────────────────

# URL of the running relay
RELAY_URL=http://localhost:8000

# Must match DEV_TOKEN above (or a real user token in production)
RELAY_TOKEN=dumpling-dev-token

# Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Claude model
CLAUDE_MODEL=claude-sonnet-4-6

# Poll interval in seconds (faster when waiting for user reply)
POLL_INTERVAL=30
POLL_INTERVAL_REPLY=5

# Where to write draft files
DUMPLING_DRAFTS_DIR=~/Dumpling/Drafts

# Claude Coding project ID — appended to software idea notes
# Get from https://claude.ai/project/ when viewing your Coding project
DUMPLING_CODING_PROJECT_ID=

# Airtable Personal Access Token — for Job Hunt base (Companies + Jobs)
# Create at https://airtable.com/create/tokens
AIRTABLE_API_KEY=

# Apple Music (optional — for automatic add to Explore playlist)
# Without these, add_catalog_to_explore opens the URL in Music.app instead.
# See https://developer.apple.com/documentation/applemusicapi
# APPLE_MUSIC_DEVELOPER_TOKEN=   # JWT from Apple Developer
# APPLE_MUSIC_USER_TOKEN=        # Music user token (authorize via MusicKit)
