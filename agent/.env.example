# Copy to agent/.env (git-ignored) and fill in. Never commit the real file.
RELAY_URL=https://dumpling-relay.fly.dev
RELAY_TOKEN=
# Omit if you've run `ant auth login`; the SDK picks up that profile instead.
ANTHROPIC_API_KEY=

# Optional
REMINDERS_LIST=Dumpling
NOTES_FOLDER=Dumpling
# Empty = first writable calendar
CALENDAR=
POLL_SECONDS=30
